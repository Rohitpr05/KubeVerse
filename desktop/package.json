{
  "name": "@kubeverse/desktop",
  "version": "4.2.0",
  "private": true,
  "type": "commonjs",
  "description": "KubeVerse desktop shell (Electron): owns the local backend process lifecycle and loads the KubeVerse UI. CommonJS deliberately, not ESM like the rest of the monorepo: Electron's own built-in `electron` module (app, BrowserWindow, ...) is a native binding that Electron's module loader only swaps in for require() - importing it under Node's own ESM loader resolves to the plain npm package instead (which only exports the path to the electron binary, for spawning it externally) and leaves app/BrowserWindow undefined. CommonJS is also what Electron's own official quickstart template uses for exactly this reason.",
  "main": "src/main.js",
  "author": {
    "name": "Rohit PR",
    "email": "rohit@zencode.ae"
  },
  "homepage": "https://github.com/Rohitpr05/KubeVerse",
  "desktopName": "KubeVerse.desktop",
  "productName": "KubeVerse",
  "scripts": {
    "dev": "electron .",
    "test": "node --test 'src/**/*.test.js'",
    "prepare-backend-deps": "node scripts/prepare-backend-deps.js",
    "package": "npm run prepare-backend-deps && electron-builder",
    "release": "npm run prepare-backend-deps && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.kubeverse.desktop",
    "productName": "KubeVerse",
    "executableName": "kubeverse",
    "artifactName": "KubeVerse-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Rohitpr05",
      "repo": "KubeVerse"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend"
      },
      {
        "from": ".stage/backend-deps/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "description": "Local-first workstation for learning Docker and Kubernetes"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

{
  "name": "kubeverse-legacy-simulator",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kubeverse-legacy-simulator",
      "workspaces": [
        "shared",
        "services/*"
      ]
    },
    "node_modules/@simulator/gateway": {
      "resolved": "services/gateway",
      "link": true
    },
    "node_modules/@simulator/ocr": {
      "resolved": "services/ocr",
      "link": true
    },
    "node_modules/@simulator/security": {
      "resolved": "services/security",
      "link": true
    },
    "node_modules/@simulator/shared": {
      "resolved": "shared",
      "link": true
    },
    "node_modules/@simulator/validation": {
      "resolved": "services/validation",
      "link": true
    },
    "services/gateway": {
      "name": "@simulator/gateway",
      "dependencies": {
        "@simulator/shared": "1.0.0"
      }
    },
    "services/ocr": {
      "name": "@simulator/ocr",
      "dependencies": {
        "@simulator/shared": "1.0.0"
      }
    },
    "services/security": {
      "name": "@simulator/security",
      "dependencies": {
        "@simulator/shared": "1.0.0"
      }
    },
    "services/validation": {
      "name": "@simulator/validation",
      "dependencies": {
        "@simulator/shared": "1.0.0"
      }
    },
    "shared": {
      "name": "@simulator/shared",
      "version": "1.0.0"
    }
  }
}

{
  "name": "local-microservice-simulator",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "services/*", "backend", "frontend"],
  "scripts": {
    "start:gateway": "node services/gateway/src/server.js",
    "start:validation": "node services/validation/src/server.js",
    "start:security": "node services/security/src/server.js",
    "start:ocr": "node services/ocr/src/server.js",
    "dev": "concurrently -n platform-api,frontend -c cyan,magenta \"npm run dev --workspace=@simulator/platform-backend\" \"npm run dev --workspace=@simulator/platform-frontend\"",
    "dev:backend": "npm run dev --workspace=@simulator/platform-backend",
    "dev:frontend": "npm run dev --workspace=@simulator/platform-frontend",
    "test": "node --test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

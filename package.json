{
  "name": "kubeverse",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev --workspace=@kubeverse/backend\" \"npm run dev --workspace=@kubeverse/frontend\"",
    "dev:backend": "npm run dev --workspace=@kubeverse/backend",
    "dev:frontend": "npm run dev --workspace=@kubeverse/frontend",
    "test": "npm run test --workspace=@kubeverse/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
